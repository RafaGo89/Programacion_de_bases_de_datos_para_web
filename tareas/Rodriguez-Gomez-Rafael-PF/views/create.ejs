<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>

  <body>
    <%- include('partials/navbar') %>

    <!-- Page Header-->
    <header
      class="masthead"
      style="background-image: url(&quot;/img/create-bg.jpg&quot;)"
    >
      <div class="container position-relative px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
          <div class="col-md-10 col-lg-8 col-xl-7">
            <div class="page-heading">
              <h1>Nuevo equipo</h1>
              <span class="subheading"
                >Añade el equipo de futbol que gustes.</span
              >
            </div>
          </div>
        </div>
      </div>
    </header>
    <!-- Main Content-->
    <main class="mb-4">
      <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
          <div class="col-md-10 col-lg-8 col-xl-7">

            <% if (validationErrors && validationErrors.length) { %>
             <ul class="list-group">
              <% validationErrors.forEach(errorMessage => { %>
               <li class="list-group list-group-item-danger">
                <%= errorMessage %>
               </li>
              <% }) %>
             </ul>
            <% } %>
            
            <p>Ingresa la información del equipo:</p>
            <div class="my-5">
              <form
                action="/equipos/store"
                method="POST"
                id="contactForm"
                data-sb-form-api-token="API_TOKEN"
              >
                <div class="form-floating">
                  <input
                    class="form-control"
                    id="nombreEquipo"
                    type="text"
                    placeholder="Ingresa el nombre del equipo..."
                    data-sb-validations="required"
                    name="nombreEquipo"
                    value = "<%= nombreEquipo %>"
                  />
                  <label for="nombreEquipo">Nombre del equipo</label>
                </div>
                <div class="form-floating">
                  <input
                    class="form-control"
                    id="anioFundacion"
                    type="number"
                    placeholder="Ingresa el año de fundación del equipo..."
                    data-sb-validations="required"
                    name="anioFundacion"
                    value = "<%= anioFundacion %>"
                  />
                  <label for="anioFundacion">Año de fundación del equipo</label>
                </div>
                <div class="form-floating">
                  <input
                    class="form-control"
                    id="pais"
                    type="text"
                    placeholder="Ingresa el país donde juega el equipo..."
                    data-sb-validations="required"
                    name="pais"
                    value = "<%= pais %>"
                  />
                  <label for="pais">País donde juega el equipo</label>
                </div>
                <br />
                <!-- Submit Button-->
                <button
                  class="btn btn-primary text-uppercase"
                  id="submitButton"
                  type="submit"
                >
                  Enviar
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %> <%- include('partials/scripts') %>
  </body>
</html>
