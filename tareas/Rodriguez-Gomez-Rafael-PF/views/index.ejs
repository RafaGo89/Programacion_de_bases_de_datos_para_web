<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>

  <body>
    <%- include('partials/navbar') %>

    <!-- Page Header-->
    <header
      class="masthead"
      style="background-image: url(&quot;/img/home-bg.jpg&quot;)"
    >
      <div class="container position-relative px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
          <div class="col-md-10 col-lg-8 col-xl-7">
            <div class="site-heading">
              <h1>Todo acerca de fútbol</h1>
              <span class="subheading">El deporte de la gente</span>
            </div>
          </div>
        </div>
      </div>
    </header>
    <!-- Main Content-->
    <div class="container px-4 px-lg-5">
      <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">

          <% equipos.forEach(equipo => { %>
           
          
          <!-- Post preview-->
          <div class="post-preview">
            <a href="/equipos/id/<%= equipo._id %>">
              <h2 class="post-title"><%= equipo.nombreEquipo %></h2>
              <!-- <h3 class="post-subtitle">
                Son conocidos mundialmente como los "Diablos Rojos", un equipo
                que representa el infierno en la cancha, jugando en el Estadio
                Nemesio Diez.
              </h3> -->
            </a>
            <p class="post-meta">
              Publicado por <%= equipo.usuarioId.nombre %>
              <!-- <a href="#!">Rafael Gómez</a> -->
              el <%= equipo.fechaPublicacion.toLocaleString() %>
            </p>
          </div>
          <!-- Divider-->
          <hr class="my-4" />

          <% }) %>

          <!-- Pager-->
          <div class="d-flex justify-content-end mb-4">
            <a class="btn btn-primary text-uppercase" href="#!"
              >Publicaciones anteriores →</a
            >
          </div>
        </div>
      </div>
    </div>

    <%- include('partials/footer') %> <%- include('partials/scripts') %>
  </body>
</html>
